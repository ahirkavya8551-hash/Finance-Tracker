rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles: Allow users to read and write their own profile
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Transactions: Allow users to manage their own transactions
    match /transactions/{transactionId} {
      // Allow read (get/list) if the user is authenticated and queries their own data
      allow read: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid);
      
      // Allow create/update if the user is authenticated and setting their own uid
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      
      // Allow delete if it belongs to the user
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
    
    // Login IDs: Allow public read for lookup during login, but restrict writes
    match /loginIds/{loginId} {
      allow read: if true; 
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    
    // Reminders: Allow authenticated users to manage their own reminders
    match /reminders/{reminderId} {
      allow read: if request.auth != null && (resource == null || resource.data.user_id == request.auth.uid);
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }
  }
}
